PSQL_HOST=csce-315-db.engr.tamu.edu
PSQL_PORT=5432
PSQL_USER=your_database_user
PSQL_DATABASE=your_database_name
PSQL_PASSWORD=your_database_password
# Use a long, random secret shared by all deployment instances.
SESSION_SECRET=replace_with_a_random_secret
# Only for a local PostgreSQL instance that does not use TLS:
# PSQL_SSL=false
# Google OAuth (https://console.cloud.google.com/apis/credentials → OAuth client ID → Web application)
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
# Optional: force the public URL used to build the redirect URI (no trailing slash).
# APP_BASE_URL=https://popping-pos-squad51.onrender.com
# Optional MyMemory contact email: raises its documented free allowance from
# 5,000 to 50,000 characters/day. Sent server-side to MyMemory with requests.
MYMEMORY_EMAIL=your_contact_email@example.com
# OpenWeather current conditions (server-side only). Get a key at https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=
# Optional store location; defaults to College Station, Texas, with Fahrenheit temperatures.
OPENWEATHER_LAT=30.6280
OPENWEATHER_LON=-96.3344
OPENWEATHER_LOCATION=College Station, TX
