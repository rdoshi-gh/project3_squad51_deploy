PSQL_HOST=csce-315-db.engr.tamu.edu
PSQL_PORT=5432
PSQL_USER=your_database_user
PSQL_DATABASE=your_database_name
PSQL_PASSWORD=your_database_password
# Use a long, random secret shared by all deployment instances.
SESSION_SECRET=replace_with_a_random_secret
# Only for a local PostgreSQL instance that does not use TLS:
# PSQL_SSL=false
