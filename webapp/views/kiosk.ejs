<%- include('partials/head', { title: 'Customer Kiosk', script: 'kiosk' }) %>
<body class="kiosk-page" data-view="kiosk">
    <a class="kiosk-skip-link" href="#kiosk-menu">Skip to menu</a>
    <header class="kiosk-topbar">
        <a class="kiosk-brand" href="/kiosk" aria-label="Popping Boba home">
            <span class="kiosk-brand-mark" aria-hidden="true">✿</span>
            <span><strong>Popping</strong><small>BOBA & TEA</small></span>
        </a>
        <a href="/" class="portal-back">Back to Portal</a>
        <p class="kiosk-top-note">Freshly made. Made your way.</p>
        <%- include('partials/accessibility') %>
        <% if (customer) { %>
        <form class="kiosk-rewards" method="post" action="/kiosk/sign-out">
            <span class="kiosk-rewards-points"><%= customer.firstName ? `Hi ${customer.firstName}! ` : '' %><strong><%= customer.points %></strong> <%= customer.points === 1 ? 'point' : 'points' %></span>
            <button type="submit" class="kiosk-rewards-signout">Sign out</button>
        </form>
        <% } %>
        <span class="kiosk-order-badge" aria-label="Your order"><span aria-hidden="true">♡</span> Your order <strong id="kiosk-cart-count">0</strong></span>
    </header>


    <% if (signinError) { %><p class="kiosk-signin-error" role="alert"><%= signinError %></p><% } %>
    <main id="kiosk-welcome-screen" class="kiosk-welcome-screen">
        <section class="kiosk-welcome-card" aria-labelledby="kiosk-welcome-title">
            <div class="kiosk-welcome-art" aria-hidden="true"><span>✿</span><div class="welcome-cup"><i></i><b>● ● ●</b></div></div>
            <div class="kiosk-welcome-copy">
                <p class="kiosk-eyebrow" data-i18n="welcome.eyebrow">WELCOME TO POPPING BOBA</p>
                <h1 id="kiosk-welcome-title" data-i18n="welcome.title">A little boba,<br><em>a lot of joy.</em></h1>
                <p data-i18n="welcome.description">Tell us what to call you, then build your perfect drink.</p>
                <form id="kiosk-name-form" class="kiosk-name-form">
                    <label for="kiosk-customer-name" data-i18n="welcome.nameLabel">Your name</label>
                    <input id="kiosk-customer-name" name="customerName" type="text" maxlength="40" autocomplete="given-name" placeholder="Enter your name" value="<%= customer && customer.firstName ? customer.firstName : '' %>" required>
                    <p id="kiosk-name-error" class="kiosk-message" role="alert"></p>
                    <button class="kiosk-primary kiosk-start-button" type="submit"><span data-i18n="welcome.startOrder">Start my order</span> <span aria-hidden="true">→</span></button>
                </form>
                <% if (customer) { %>
                <p class="kiosk-welcome-note">You're signed in. This order will earn rewards points.</p>
                <% } else if (googleEnabled) { %>
                <a class="kiosk-rewards-signin" href="/auth/google/customer">Sign in with Google to earn points</a>
                <p class="kiosk-welcome-note">Optional. No account needed. Just good drinks.</p>
                <% } else { %>
                <p class="kiosk-welcome-note">No account needed. Just good drinks.</p>
                <% } %>
            </div>
        </section>
    </main>

    <main id="kiosk-order-screen" class="kiosk-main" hidden>
        <section class="kiosk-hero" aria-labelledby="kiosk-welcome">
            <div class="kiosk-hero-copy">
                <p class="kiosk-eyebrow">MADE FOR YOU, <span id="kiosk-name-greeting">BOBA FAN</span></p>
                <h1 id="kiosk-welcome">Explore our<br><em>Menu.</em></h1>
                <p>Pick a favorite, make it yours, and we'll make it fresh.</p>
                <a class="kiosk-hero-cta" href="#kiosk-menu">Find Your Drink <span aria-hidden="true">↓</span></a>
            </div>
            <div class="kiosk-hero-art" aria-hidden="true"></div>
        </section>
        <section id="kiosk-menu" class="kiosk-menu-section" aria-labelledby="kiosk-menu-title">
            <div class="kiosk-section-heading"><div><p class="kiosk-eyebrow">Our Menu</p><h2 id="kiosk-menu-title" data-i18n="menu.title">Find Your Drink</h2></div><p data-i18n="menu.instructions">Choose a drink, then customize every detail.</p></div>
            <div id="kiosk-message" class="kiosk-message" role="alert"></div>
            <div class="kiosk-menu-tools"><nav id="kiosk-categories" class="kiosk-categories" aria-label="Filter drinks"></nav><label class="kiosk-search"><span class="sr-only">Search drinks</span><span aria-hidden="true">⌕</span><input id="kiosk-search" type="search" placeholder="Find a favorite…" autocomplete="off"></label></div>
            <div id="kiosk-menu-grid" class="kiosk-menu-grid" aria-live="polite"><p class="kiosk-empty">Getting the good stuff ready…</p></div>
        </section>
        <section class="kiosk-bottom-note"><p><strong data-i18n="menu.noteTitle">A little note from us</strong><br><span data-i18n="menu.noteBody">Every drink is made fresh. Customize sweetness, ice, size, and toppings to make it yours.</span></p></section>
    </main>
    <aside id="kiosk-cart-bar" class="kiosk-cart-bar" aria-label="Your order summary" hidden>
        <div class="kiosk-cart-summary"><span class="kiosk-cart-icon" aria-hidden="true">♡</span><div><strong id="kiosk-cart-label">Your order is waiting</strong><small id="kiosk-cart-hint">Add a drink to get started</small></div></div>
        <div class="kiosk-cart-total"><span>Subtotal</span><strong id="kiosk-cart-total">$0.00</strong></div>
        <button id="kiosk-review" class="kiosk-checkout" type="button" disabled>Review order <span aria-hidden="true">→</span></button>
    </aside>
    <dialog id="kiosk-dialog" class="kiosk-dialog" aria-labelledby="kiosk-dialog-title"><div id="kiosk-dialog-body"></div></dialog>
    <div id="kiosk-announcement" class="sr-only" role="status" aria-live="polite"></div>
</body>
</html>
