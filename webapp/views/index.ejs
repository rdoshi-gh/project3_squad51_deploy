<%- include('partials/head', { title: 'Portal', script: null }) %>
<body class="center-page portal-page">
    <main class="entry-card portal-card">
        <p class="portal-eyebrow"><span aria-hidden="true">✿</span> Portal Hub</p>
        <h1>Popping POS (Team 51)</h1>
        <p class="portal-subtitle">Choose an interface view</p>
        <nav class="portal-actions" aria-label="Interface views">
            <a href="/manager/login" class="portal-button">
                <strong>Manager Dashboard</strong>
                <small>Sales reports, menu, and inventory</small>
            </a>
            <a href="/cashier/login" class="portal-button">
                <strong>Cashier Screen</strong>
                <small>Take orders behind the counter</small>
            </a>
            <a href="/kiosk" class="portal-button">
                <strong>Customer Kiosk</strong>
                <small>Self-service ordering for guests</small>
            </a>
            <a href="/kitchen" class="portal-button">
                <strong>Kitchen Display</strong>
                <small>Incoming orders for the kitchen</small>
            </a>
        </nav>
    </main>
</body>
</html>
